+/* Wine does not generate Windows kernel crash dumps. Keep real callback
+ * registrations and their lifetime, so drivers may register and unload safely. */
+struct bugcheck_reason_record
+{
+    LIST_ENTRY entry;
+    void (WINAPI *routine)(ULONG, void *, void *, ULONG);
+    unsigned char *component;
+    ULONG_PTR checksum;
+    ULONG reason;
+    UCHAR state;
+};
+static LIST_ENTRY bugcheck_reason_list = { &bugcheck_reason_list, &bugcheck_reason_list };
+DECLARE_CRITICAL_SECTION(bugcheck_cs);
+
+BOOLEAN WINAPI KeRegisterBugCheckReasonCallback(struct bugcheck_reason_record *record,
+        void (WINAPI *routine)(ULONG, void *, void *, ULONG), ULONG reason, unsigned char *component)
+{
+    BOOLEAN result = FALSE;
+    if (!record || !routine || !reason || reason > 7) return FALSE;
+    EnterCriticalSection(&bugcheck_cs);
+    if (!record->state)
+    {
+        record->routine = routine;
+        record->component = component;
+        record->reason = reason;
+        record->checksum = (ULONG_PTR)record + (ULONG_PTR)routine + (ULONG_PTR)component + reason;
+        InsertTailList(&bugcheck_reason_list, &record->entry);
+        record->state = 1; /* BufferInserted */
+        result = TRUE;
+    }
+    LeaveCriticalSection(&bugcheck_cs);
+    TRACE("record %p, reason %lu, registered %u.\n", record, reason, result);
+    return result;
+}
+
+BOOLEAN WINAPI KeDeregisterBugCheckReasonCallback(struct bugcheck_reason_record *record)
+{
+    LIST_ENTRY *entry;
+    BOOLEAN result = FALSE;
+    if (!record) return FALSE;
+    EnterCriticalSection(&bugcheck_cs);
+    for (entry = bugcheck_reason_list.Flink; entry != &bugcheck_reason_list; entry = entry->Flink)
+    {
+        if (entry != &record->entry) continue;
+        RemoveEntryList(entry);
+        record->state = 0; /* BufferEmpty */
+        result = TRUE;
+        break;
+    }
+    LeaveCriticalSection(&bugcheck_cs);
+    return result;
 }
 
