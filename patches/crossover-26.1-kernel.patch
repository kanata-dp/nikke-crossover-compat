+/* Like the Wine-derived Endfield fallback, report an unsupported operation
+ * without fabricating kernel dump contents or a successful capture. */
+NTSTATUS WINAPI KeCapturePersistentThreadState(CONTEXT *context, PKTHREAD thread, ULONG code,
+        ULONG_PTR param1, ULONG_PTR param2, ULONG_PTR param3, ULONG_PTR param4, void *buffer)
+{
+    FIXME("context %p, thread %p, code %#lx, parameters %Ix %Ix %Ix %Ix, buffer %p: unsupported.\n",
+          context, thread, code, param1, param2, param3, param4, buffer);
+    return STATUS_NOT_IMPLEMENTED;
+}
