+/* Inverse of Wine's existing logical identity mapping. An arbitrary physical
+ * address must not become a dereferenceable pointer to uncommitted memory. */
+void *WINAPI MmGetVirtualForPhysical(PHYSICAL_ADDRESS address)
+{
+    MEMORY_BASIC_INFORMATION info;
+    void *pointer = (void *)(ULONG_PTR)address.QuadPart;
+
+    if ((ULONGLONG)(ULONG_PTR)pointer != (ULONGLONG)address.QuadPart || !pointer)
+        return NULL;
+    if (!VirtualQuery(pointer, &info, sizeof(info)) || info.State != MEM_COMMIT ||
+        (info.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+        return NULL;
+    TRACE("Logical physical address %s -> %p.\n", wine_dbgstr_longlong(address.QuadPart), pointer);
+    return pointer;
+}
+
+struct wine_physical_memory_range
+{
+    PHYSICAL_ADDRESS BaseAddress;
+    LARGE_INTEGER NumberOfBytes;
+};
+
+struct wine_physical_memory_range *WINAPI MmGetPhysicalMemoryRanges(void)
+{
+    SYSTEM_BASIC_INFORMATION info;
+    struct wine_physical_memory_range *ranges;
+    NTSTATUS status;
+
+    if ((status = NtQuerySystemInformation(SystemBasicInformation, &info, sizeof(info), NULL)))
+    {
+        WARN("Failed to query memory information, status %#lx.\n", status);
+        return NULL;
+    }
+    /* Wine exposes one logical physical-memory span. Allocate a fresh,
+     * terminated array: Windows callers own it and release it with ExFreePool. */
+    if (!(ranges = ExAllocatePool(NonPagedPool, 2 * sizeof(*ranges)))) return NULL;
+    memset(ranges, 0, 2 * sizeof(*ranges));
+    ranges[0].BaseAddress.QuadPart = (ULONGLONG)info.MmLowestPhysicalPage * info.PageSize;
+    ranges[0].NumberOfBytes.QuadPart = (ULONGLONG)info.MmNumberOfPhysicalPages * info.PageSize;
+    return ranges;
+}
