+/* Return the owning process already stored in Wine's thread object.
+ * The caller borrows this pointer; this query does not add a reference. */
+PEPROCESS WINAPI PsGetThreadProcess(PETHREAD thread)
+{
+    TRACE("%p -> %p\n", thread, thread->kthread.process);
+    return thread->kthread.process;
+}
